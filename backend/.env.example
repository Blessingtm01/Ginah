# Copy to .env (or set as environment variables). Placeholders only - never commit real values.
ACCISAFE_ENV=development
# Production: postgresql+psycopg://accisafe:CHANGE_ME@db-host:5432/accisafe_rdc
ACCISAFE_DATABASE_URL=sqlite:///./data/accisafe_rdc.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCISAFE_SECRET_KEY=CHANGE_ME
ACCISAFE_ACCESS_TOKEN_MINUTES=15
ACCISAFE_REFRESH_TOKEN_DAYS=14
ACCISAFE_ATTACHMENT_DIR=./data/attachments
# "log" = development: SMS recorded as SIMULATED, nothing sent. "http" = real gateway below.
ACCISAFE_SMS_PROVIDER=log
ACCISAFE_SMS_HTTP_URL=
ACCISAFE_SMS_HTTP_TOKEN=
ACCISAFE_SMS_SENDER_ID=AcciSafe
ACCISAFE_ESCALATION_INTERVAL_SECONDS=60
