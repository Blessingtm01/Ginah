{
  "name": "AcciSafe RDC Console",
  "short_name": "AcciSafe RDC",
  "description": "Live council incident map and reports for Rural District Council staff.",
  "start_url": "/console/",
  "scope": "/console/",
  "display": "standalone",
  "background_color": "#F4F7F5",
  "theme_color": "#14532D",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
